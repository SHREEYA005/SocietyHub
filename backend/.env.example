# ---- Core ----
APP_NAME=SocietyHub
ENVIRONMENT=development

# ---- Database ----
# For local dev, SQLite requires no setup:
DATABASE_URL=sqlite:///./societyhub.db
# For production, use Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/societyhub

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Overdue detection ----
OVERDUE_THRESHOLD_DAYS=3

# ---- File storage ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- Email (SMTP) ----
# Leave EMAIL_HOST empty to log emails to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@societyhub.local
EMAIL_USE_TLS=true

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
